# C-SKY V2: the signed 64-bit multiply family is missing from the module
#
# taligentx/ghidra_csky_ck804 v0.2 implements the unsigned mulu/mulua/mulus
# family at i32_r_sop = 0b100010 but not its signed counterpart at 0b100011.
# Ghidra's flow analysis stops dead at an instruction it cannot decode, so
# every function containing one is silently truncated - the decompiler emits
# halt_baddata() at the first line and the function body stops short.
#
# 42 sites across the IRAM image are affected.  Among them the FFT butterfly
# kernels the vocoder's analyser depends on:
#
#     Dsp_FftStageButterfly       0x00025160   truncates at 0x000251A4
#     Dsp_FftFinalStageButterfly  0x0002509C   truncates at 0x000250E0
#
# The encoding is identified by its neighbours rather than by a manual: the
# instruction is op=0b0001 sop=0b100011 pcode=0b00001 with rz=0, which is
# exactly the shape of mulu one sop lower, and the C-SKY V2 multiply group
# pairs unsigned and signed families adjacently.
#
# Apply to the installed module's data/languages/32b_data.sinc, then
# recompile and restart Ghidra:
#
#     $GHIDRA/support/sleigh -a <module>/data/languages
#
--- a/32b_data.sinc	2026-08-29 13:01:45
+++ b/32b_data.sinc	2026-08-29 13:01:45
@@ -371,7 +371,33 @@
         }
         :divu i32_r_rz, i32_r_rx, i32_r_ry is i32_r_pcode = 0b00001 & i32_r_rz & i32_r_rx & i32_r_ry {
             i32_r_rz = i32_r_rx / i32_r_ry;
+        }
+    }
+
+    # Signed counterpart of the mulu/mulua/mulus family below.  Same shape -
+    # rz must be 0, the 64-bit result lands in hi:lo - one sop higher, and
+    # signed.  Its absence truncated every function that used it, because
+    # Ghidra's flow analysis stops dead at an undecodable instruction: the FFT
+    # butterfly kernels Dsp_FftStageButterfly 0x00025160 and
+    # Dsp_FftFinalStageButterfly 0x0002509C, and 42 sites across IRAM.
+    with : i32_r_sop = 0b100011 {
+        :muls i32_r_rx, i32_r_ry is i32_r_pcode = 0b00001 & i32_r_rz = 0b00000 & i32_r_rx & i32_r_ry {
+            local tmp:8 = sext(i32_r_rx) * sext(i32_r_ry);
+            lo = tmp:4;
+            hi = tmp(4);
         }
+        :mulsa i32_r_rx, i32_r_ry is i32_r_pcode = 0b00010 & i32_r_rz = 0b00000 & i32_r_rx & i32_r_ry {
+            local acc:8 = (zext(hi) << 32) | zext(lo);
+            local tmp:8 = acc + sext(i32_r_rx) * sext(i32_r_ry);
+            lo = tmp:4;
+            hi = tmp(4);
+        }
+        :mulss i32_r_rx, i32_r_ry is i32_r_pcode = 0b00100 & i32_r_rz = 0b00000 & i32_r_rx & i32_r_ry {
+            local acc:8 = (zext(hi) << 32) | zext(lo);
+            local tmp:8 = acc - sext(i32_r_rx) * sext(i32_r_ry);
+            lo = tmp:4;
+            hi = tmp(4);
+        }
     }
 
     with : i32_r_sop = 0b100010 {
